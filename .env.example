# -----------------------------------------------------------------------------
# GIPSE environment variables
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.
# -----------------------------------------------------------------------------

# Public site URL, no trailing slash. Used for canonical URLs, sitemap,
# Open Graph and payment return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). A legacy "anon" JWT key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# SERVER ONLY. Secret key (sb_secret_...) or legacy service_role JWT.
# Used for checkout, rate limiting, Telegram bookkeeping and payment callbacks.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram (optional until configured) ------------------------------------
# Create a bot with @BotFather; see DEPLOYMENT.md §6.
TELEGRAM_BOT_TOKEN=
# Numeric chat ID of the owner or shop group (groups start with -100...).
TELEGRAM_CHAT_ID=

# --- Scheduled jobs ----------------------------------------------------------
# Random string (≥ 32 chars). Vercel Cron sends it as a Bearer token to
# /api/cron/telegram-retry. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Online card payments via ArCa (optional, disabled when empty) -----------
# Credentials are issued by your acquiring bank after merchant onboarding.
# See PAYMENTS.md before enabling.
ARCA_API_BASE_URL=
ARCA_USERNAME=
ARCA_PASSWORD=
# Secret key for callback checksum verification (provided by the bank when
# "callback with checksum" is enabled for your merchant).
ARCA_CALLBACK_SECRET=
